.globe {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  width: 100vw;
}

.globe__canvas {
  display: block;
  flex: 1;
  height: 0;
  min-height: 0;
  position: relative;
  width: 100%;
}

.globe__status {
  background: #111b23;
  border-bottom: 1px solid #35434d;
  box-sizing: border-box;
  color: #dceaf0;
  flex-shrink: 0;
  font-size: 12px;
  height: 88px;
  line-height: 18px;
  overflow: hidden;
  padding: 8px 14px 6px;
}

.globe__status-line {
  display: block;
  height: 18px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.globe__status--failed {
  border-color: rgba(255, 120, 110, 0.8);
  color: #ffb4aa;
}

.globe__status--warning {
  border-color: rgba(242, 190, 85, 0.8);
  color: #ffe09a;
}

.globe__metrics {
  color: #9fb4be;
  display: block;
  font-family: monospace;
  height: 54px;
  line-height: 18px;
  margin-top: 2px;
  overflow: hidden;
  white-space: pre-line;
}

.globe__footer {
  background: #111b23;
  border-top: 1px solid #35434d;
  box-sizing: border-box;
  flex-shrink: 0;
  height: calc(126px + env(safe-area-inset-bottom));
  padding: 6px 10px calc(10px + env(safe-area-inset-bottom));
}

.globe__attribution {
  color: rgba(231, 242, 246, 0.82);
  display: block;
  font-size: 11px;
  height: 18px;
  line-height: 16px;
  text-align: right;
}

.globe__modebar {
  align-items: center;
  display: flex;
  gap: 5px;
  height: 34px;
  margin-bottom: 5px;
}

.globe__mode {
  align-items: center;
  background: rgba(18, 31, 39, 0.96);
  border: 1px solid rgba(224, 238, 246, 0.3);
  border-radius: 4px;
  box-sizing: border-box;
  color: #d7e5ea;
  display: flex;
  font-size: 13px;
  height: 32px;
  justify-content: center;
  line-height: 32px;
  margin: 0;
  min-height: 32px;
  padding: 0;
  width: 68px;
}

.globe__mode--active {
  background: #d9ecef;
  border-color: #d9ecef;
  color: #0d242c;
  font-weight: 600;
}

.globe__mode--icon {
  width: 40px;
}

.globe__mode--retry {
  color: #ffe09a;
  width: 54px;
}

.globe__mode-spacer {
  flex: 1;
}

.globe__mode[disabled] {
  background: rgba(32, 44, 52, 0.8);
  color: #6f818b;
}

.globe__mode::after {
  border: 0;
}

.globe__toolbar {
  display: flex;
  gap: 5px;
  height: 40px;
  justify-content: center;
}

.globe__tool {
  align-items: center;
  background: rgba(12, 28, 40, 0.9);
  border: 1px solid rgba(224, 238, 246, 0.3);
  border-radius: 4px;
  box-sizing: border-box;
  color: #f3fbff;
  display: flex;
  font-size: 15px;
  height: 40px;
  justify-content: center;
  line-height: 40px;
  margin: 0;
  min-height: 40px;
  min-width: 38px;
  padding: 0;
  width: 38px;
}

.globe__tool--text {
  font-size: 12px;
}

.globe__tool[disabled] {
  background: rgba(32, 44, 52, 0.8);
  color: #6f818b;
}

.globe__tool::after {
  border: 0;
}

.globe__tool:active {
  background: rgba(40, 98, 126, 0.95);
  border-color: rgba(224, 238, 246, 0.72);
}
