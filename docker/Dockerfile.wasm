ARG TERRA_SDK_WASM_BASE_IMAGE=ubuntu:22.04@sha256:0bced47fffa3361afa981854fcabcd4577cd43cebbb808cea2b1f33a3dd7f508
FROM ${TERRA_SDK_WASM_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN sed -i -e 's|http://archive.ubuntu.com/ubuntu/|http://mirrors.tuna.tsinghua.edu.cn/ubuntu/|g' \
           -e 's|http://security.ubuntu.com/ubuntu/|http://mirrors.tuna.tsinghua.edu.cn/ubuntu/|g' \
           /etc/apt/sources.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    emscripten=3.1.5~dfsg-3ubuntu1 \
    binaryen=105-1 \
    nodejs \
    python3 \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

ARG UID=1000
ARG GID=1000

RUN groupadd -g ${GID} terra-wasm \
    && useradd -u ${UID} -g terra-wasm -m terra-wasm

USER terra-wasm
WORKDIR /workspace

RUN em++ --version \
    && wasm-opt --version \
    && node --version \
    && cmake --version

CMD ["/bin/bash"]